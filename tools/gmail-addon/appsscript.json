{
  "timeZone": "Europe/Rome",
  "runtimeVersion": "V8",
  "exceptionLogging": "STACKDRIVER",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.readonly",
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/userinfo.email"
  ],
  "urlFetchWhitelist": [
    "https://casteltech-portale.onrender.com/"
  ],
  "addOns": {
    "common": {
      "name": "Portale Casteltech",
      "logoUrl": "https://www.gstatic.com/images/icons/material/system/1x/send_black_48dp.png",
      "layoutProperties": { "primaryColor": "#1f6f50" },
      "homepageTrigger": { "runFunction": "paginaIniziale" }
    },
    "gmail": {
      "contextualTriggers": [
        { "unconditional": {}, "onTriggerFunction": "apriMail" }
      ]
    }
  }
}
